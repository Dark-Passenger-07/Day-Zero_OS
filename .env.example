# ────────── DAY ZERO OS ENVIRONMENT CONFIGURATION ──────────
# Copy this file to '.env' and fill in your credentials.

# ─── 1. Application Deployment settings
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:8443
PORT=8443

# ─── 2. Supabase Integration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── 3. Email Integration & Delivery Settings
# Supported providers: "resend", "smtp", "console" (falls back to browser console)
VITE_EMAIL_PROVIDER=console
VITE_RESEND_API_KEY=re_yourApiKeyHere
VITE_INVITATION_FROM_EMAIL=Day Zero OS <invites@dayzero.dev>
VITE_SMTP_ENDPOINT=smtps://username:password@smtp.mailtrap.io:2525

# ─── 4. Analytics & Tracking
# Microsoft Clarity project ID (optional)
VITE_CLARITY_ID=your_clarity_project_id
